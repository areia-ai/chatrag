# Server Configuration
PORT=3000

# Required for production. Every route except /health needs
# "Authorization: Bearer <API_KEY>". Use the same value as FLYIO_API_KEY
# (or KOYEB_API_KEY) in ChatRAG.
API_KEY=

# Where to send incoming messages, and the secret used to sign them.
# WEBHOOK_SECRET must match WHATSAPP_WEBHOOK_SECRET in ChatRAG.
WEBHOOK_URL=
WEBHOOK_SECRET=

# WhatsApp Configuration
# Set to true if you want to use pairing code instead of QR
USE_PAIRING_CODE=false

# Phone number for pairing code (only used if USE_PAIRING_CODE=true)
# Format: country code + number without spaces or special characters
# Example: 1234567890
PHONE_NUMBER=