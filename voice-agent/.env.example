# LiveKit Configuration (Get these from LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Internal RAG API (ChatRAG)
CHATRAG_INTERNAL_API_URL=http://localhost:3000/api/internal/voice-rag
CHATRAG_INTERNAL_API_KEY=sk-internal-your-internal-key

# STT Provider - Required
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# TTS Providers - Configure at least one (Resemble AI or Hume AI)
# Resemble AI TTS
RESEMBLE_API_KEY=your_resemble_api_key
RESEMBLE_VOICE_ID=your_resemble_voice_id
RESEMBLE_STREAM_URL=https://f.cluster.resemble.ai/stream



# LLM Configuration - Optional (defaults to OpenAI gpt-4o)
# Model to use (OpenAI format: gpt-4o, Groq format: llama-3.3-70b-versatile, OpenRouter format: google/gemini-3-flash-preview)
VOICE_AGENT_MODEL=gpt-4o

# Provider Selection (openai, openrouter or groq)
VOICE_AGENT_LLM_PROVIDER=openai

# For OpenAI: Set API key if using OpenAI provider
OPENAI_API_KEY=sk-proj-your-openai-key

# For Groq: Set API key if using Groq provider
GROQ_API_KEY=gsk_your-groq-key

# For OpenRouter: Set API key if using OpenRouter provider
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Speech Recognition Language - Optional (default: en)
# Supported: en, es, fr, de, pt, it, nl, ja, ko, zh, etc.
ASSEMBLYAI_LANGUAGE=en

# Visual Display Mode (orb, orb_text, text) - Optional (default: orb)
VOICE_DISPLAY_MODE=orb

# Debug Mode - Optional
SINE_TEST_MODE=false
